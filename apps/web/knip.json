{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "components/ui/**",
    "source.config.ts",
    ".source/**",
    "scripts/**",
    "prisma/seed-cleanup.ts",
    "components/items/fork-destination-dialog.tsx",
    "components/items/visibility-toggle.tsx",
    "mdx-components.tsx",
    ".storybook/**",
    "e2e/**",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "instrumentation-client.ts",
    "instrumentation.ts",
    "_payload-ref/**"
  ],
  "ignoreBinaries": [],
  "ignoreDependencies": [
    "pino-pretty",
    "baseline-browser-mapping",
    "concurrently",
    "http-server",
    "wait-on"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
