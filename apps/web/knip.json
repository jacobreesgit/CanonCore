{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "components/ui/**",
    "source.config.ts",
    ".source/**",
    "scripts/**",
    "prisma/seed-cleanup.ts",
    "components/items/fork-destination-dialog.tsx",
    "components/items/visibility-toggle.tsx",
    "mdx-components.tsx",
    ".storybook/**",
    "e2e/**",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "instrumentation-client.ts",
    "instrumentation.ts",
    "_payload-ref/**"
  ],
  "ignoreBinaries": [
    "next",
    "eslint",
    "prettier",
    "tsc",
    "knip",
    "vitest",
    "tsx",
    "prisma",
    "storybook",
    "playwright",
    "test-storybook",
    "changelogen",
    "fumadocs-mdx"
  ],
  "ignoreDependencies": [
    "pino-pretty",
    "baseline-browser-mapping",
    "concurrently",
    "http-server",
    "wait-on",
    "@canoncore/types",
    "@canoncore/store",
    "@canoncore/utils",
    "@canoncore/validators",
    "@eslint/js",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "typescript-eslint",
    "@canoncore/api",
    "@trpc/tanstack-react-query",
    "@emotion/is-prop-valid",
    "@testing-library/dom",
    "babel-plugin-react-compiler",
    "changelogen",
    "eslint",
    "prettier",
    "tsx"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
