{
  "name": "@canoncore/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "lint": "eslint src/ app/",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro/ --include-tags smoke",
    "test:e2e:all": "maestro test .maestro/",
    "percy": "./scripts/percy-screenshots.sh",
    "screenshots": "./scripts/generate-screenshots.sh",
    "screenshots:ios": "./scripts/generate-screenshots.sh ios",
    "screenshots:android": "./scripts/generate-screenshots.sh android",
    "build": "echo 'Mobile builds via EAS — use eas build'",
    "format:check": "pnpm exec prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "export": "npx expo export"
  },
  "dependencies": {
    "@canoncore/api": "workspace:*",
    "@canoncore/store": "workspace:*",
    "@canoncore/types": "workspace:*",
    "@canoncore/utils": "workspace:*",
    "@canoncore/validators": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@react-native-community/slider": "5.0.1",
    "@reduxjs/toolkit": "^2.8.0",
    "@tanstack/react-query": "^5.75.0",
    "@trpc/client": "^11.1.0",
    "@trpc/tanstack-react-query": "^11.1.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-build-properties": "~0.14.5",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "nativewind": "5.0.0-preview.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "^9.0.0",
    "react-native": "0.81.5",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-track-player": "^4.1.2",
    "redux-persist": "^6.0.0",
    "superjson": "^2.2.2"
  },
  "devDependencies": {
    "@canoncore/config": "workspace:*",
    "@eslint/js": "^9.39.2",
    "@percy/cli": "^1.31.9",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "^19.1.17",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1"
  }
}
