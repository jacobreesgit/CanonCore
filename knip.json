{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "components/ui/**",
    "e2e/**",
    "source.config.ts",
    ".source/**",
    "scripts/**"
  ],
  "ignoreBinaries": ["pkill", "lsof"],
  "ignoreDependencies": ["pino-pretty"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
