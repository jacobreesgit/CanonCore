{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "components/ui/**",
    "source.config.ts",
    ".source/**",
    "scripts/**",
    "prisma/seed-cleanup.ts",
    "components/items/fork-destination-dialog.tsx",
    "components/items/visibility-toggle.tsx",
    "mdx-components.tsx",
    ".storybook/**",
    ".github/**"
  ],
  "ignoreBinaries": [],
  "ignoreDependencies": [
    "pino-pretty",
    "baseline-browser-mapping",
    "@types/mdx"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
