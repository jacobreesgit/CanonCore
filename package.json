    "next": "16.1.1",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "pino": "^10.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-dropzone": "^14.3.8",
    "react-redux": "^9.2.0",
    "resend": "^6.6.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
