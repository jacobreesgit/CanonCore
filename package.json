    "fake-indexeddb": "^6.2.5",
    "http-server": "^14.1.1",
    "jsdom": "^27.4.0",
    "knip": "^5.78.0",
    "lefthook": "^2.1.3",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^2.0.6",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.2.0",
    "storybook": "^10.2.4",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.9.3",
