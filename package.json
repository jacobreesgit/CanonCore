{
  "name": "my-v0-project",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "check": "rm -rf .next && npm run format:check && npm run lint && npm run type-check && npm run knip && npm run build",
    "test:e2e:cleanup": "pkill -f playwright 2>/dev/null; pkill -f 'next dev' 2>/dev/null; lsof -ti:3000 | xargs kill -9 2>/dev/null; exit 0",
    "test:e2e": "npm run test:e2e:cleanup && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "npm run test:e2e:cleanup && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "npm run test:e2e:cleanup && playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test": "vitest run --config tests/unit/vitest.config.ts",
    "test:watch": "vitest --config tests/unit/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tests/unit/vitest.config.ts",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@tabler/icons-react": "latest",
    "@vercel/analytics": "1.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.454.0",
    "next": "16.1.1",
    "next-auth": "5.0.0-beta.30",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.6.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.1",
    "@playwright/test": "^1.57.0",
    "@prisma/client": "^7.2.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "knip": "^5.78.0",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
