{
  "name": "canoncore",
  "version": "13.1.0",
  "packageManager": "pnpm@10.15.0",
  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx && prisma generate",
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "check": "rm -rf .next && npm run format && npm run lint && npm run type-check && npm run knip && npm run build",
    "test": "vitest run --config tests/unit/vitest.config.ts",
    "test:watch": "vitest --config tests/unit/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tests/unit/vitest.config.ts",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "setup:e2e": "tsx scripts/generate-refresh-token.ts --purpose=e2e",
    "setup:seed": "tsx scripts/generate-refresh-token.ts --purpose=seed",
    "setup:e2e-drive": "tsx scripts/setup-e2e-drive.ts",
    "setup:verify": "tsx scripts/verify-drive-setup.ts",
    "setup:all": "npm run setup:e2e && npm run setup:seed",
    "seed": "ALLOW_SEEDING=true npx prisma db seed",
    "seed:development": "SEED_TARGET=development ALLOW_SEEDING=true npx prisma db seed",
    "seed:production": "SEED_TARGET=production ALLOW_SEEDING=true npx prisma db seed",
    "seed:screenshots": "SEED_TARGET=screenshots ALLOW_SEEDING=true npx prisma db seed",
    "seed:demo": "SEED_TARGET=demo ALLOW_SEEDING=true npx prisma db seed",
    "seed:e2e": "SEED_TARGET=e2e ALLOW_SEEDING=true npx prisma db seed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "test-storybook --ci --maxWorkers=2",
    "prepare": "lefthook install",
    "analyze": "ANALYZE=true next build",
    "changelog": "changelogen",
    "release": "changelogen --release",
    "mockups": "playwright test --config=e2e/mockups/playwright.config.ts",
    "mockups:screenshots": "playwright test --config=e2e/mockups/playwright.config.ts --project=laptop --project=mobile",
    "mockups:only": "MOCKUP_ONLY=true playwright test --config=e2e/mockups/playwright.config.ts --project=mockups",
    "mockups:webp": "tsx e2e/mockups/convert-webp.ts"
  },
  "dependencies": {
