{
  "name": "canoncore",
  "version": "13.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "pnpm --filter @canoncore/web start",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "type-check": "turbo run type-check",
    "knip": "turbo run knip",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @canoncore/web test:e2e",
    "test:e2e:ui": "pnpm --filter @canoncore/web test:e2e:ui",
    "storybook": "pnpm --filter @canoncore/web storybook",
    "build-storybook": "pnpm --filter @canoncore/web build-storybook",
    "test-storybook": "pnpm --filter @canoncore/web test-storybook",
    "test-storybook:ci": "pnpm --filter @canoncore/web test-storybook:ci",
    "seed": "pnpm --filter @canoncore/web seed",
    "seed:development": "pnpm --filter @canoncore/web seed:development",
    "seed:production": "pnpm --filter @canoncore/web seed:production",
    "seed:screenshots": "pnpm --filter @canoncore/web seed:screenshots",
    "mockups": "pnpm --filter @canoncore/web mockups",
    "analyze": "pnpm --filter @canoncore/web analyze",
    "changelog": "pnpm --filter @canoncore/web changelog",
    "release": "pnpm --filter @canoncore/web release",
    "check": "turbo run format:check lint type-check knip build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "lefthook": "^2.1.3",
    "lint-staged": "^16.2.7",
    "turbo": "^2.8.16"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --config apps/web/eslint.config.mjs",
      "prettier --write --config apps/web/.prettierrc --ignore-path apps/web/.prettierignore"
    ],
    "apps/web/**/*.{json,md,css}": [
      "prettier --write --config apps/web/.prettierrc --ignore-path apps/web/.prettierignore"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
