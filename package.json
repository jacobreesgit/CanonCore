{
  "name": "canoncore",
  "version": "6.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "check": "rm -rf .next && npm run format && npm run lint && npm run type-check && npm run knip && npm run build",
    "test:e2e:cleanup": "pkill -f playwright 2>/dev/null; pkill -f 'next dev' 2>/dev/null; lsof -ti:3000 | xargs kill -9 2>/dev/null; exit 0",
    "test:e2e": "npm run test:e2e:cleanup && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "npm run test:e2e:cleanup && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "npm run test:e2e:cleanup && playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test": "vitest run --config tests/unit/vitest.config.ts",
    "test:watch": "vitest --config tests/unit/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tests/unit/vitest.config.ts",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "screenshots": "playwright test --config=e2e/screenshots/playwright.config.ts",
    "setup:e2e": "tsx scripts/generate-refresh-token.ts --purpose=e2e",
    "setup:seed": "tsx scripts/generate-refresh-token.ts --purpose=seed",
    "setup:e2e-drive": "tsx scripts/setup-e2e-drive.ts",
    "setup:verify": "tsx scripts/verify-drive-setup.ts",
    "setup:all": "npm run setup:e2e && npm run setup:seed",
    "seed:quick": "ALLOW_SEEDING=true npx prisma db seed",
    "seed:full": "ALLOW_SEEDING=true SEED_INCREMENTAL=false npx prisma db seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/mdx": "^2.0.13",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.0",
    "@vercel/analytics": "1.3.1",
    "@vidstack/react": "^1.12.13",
    "bcryptjs": "^3.0.3",
    "bottleneck": "^2.19.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "file-type": "^21.3.0",
    "framer-motion": "^12.28.1",
    "fumadocs-core": "^16.4.1",
    "fumadocs-mdx": "^14.2.3",
    "fumadocs-ui": "^16.4.1",
    "googleapis": "^170.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.454.0",
    "motion": "^12.23.12",
    "next": "16.1.1",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pino": "^10.1.0",
    "react": "^19",
    "react-dom": "^19",
    "react-dropzone": "^14.3.8",
    "resend": "^6.6.0",
    "sharp": "^0.34.5",
